package fr.ynov.nuitsduport.billet.festivalier.infrastructure;

import java.util.HashMap;
import java.util.Map;
import java.util.Optional;


public class InMemoryfestivaierRepository implements StudentRepository {

    private final Map<festivalierId, festivalier> festivaliers = new HashMap<>();

    @Override
    public Optional<festivalier> findById(festivalierId id) {
        return Optional.ofNullable(festivaliers.get(id));
    }

    @Override
    public void save(festivalier festivalier) {
        festivaliers.put(festivalier.id(), festivalier);
    }
}